<?xml version="1.0" encoding="utf-8"?>
<!--
    Background layer of the adaptive icon: the plate colour sampled from the
    supplied logo. Flat rather than a gradient, because the launcher scales,
    masks and parallaxes this layer and a gradient bands badly when it does.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#2F334B" />
</shape>
